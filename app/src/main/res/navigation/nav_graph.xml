<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/catalogFragment">

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.belobina.app.fragments.customer.CatalogFragment"
        android:label="Catalog"
        tools:layout="@layout/fragment_catalog">
        <action
            android:id="@+id/action_catalogFragment_to_orderPlacementFragment"
            app:destination="@id/orderPlacementFragment" />
    </fragment>

    <fragment
        android:id="@+id/myOrdersFragment"
        android:name="com.belobina.app.fragments.customer.MyOrdersFragment"
        android:label="My Orders"
        tools:layout="@layout/fragment_my_orders" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.belobina.app.fragments.customer.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/orderPlacementFragment"
        android:name="com.belobina.app.fragments.customer.OrderPlacementFragment"
        android:label="Place Order"
        tools:layout="@layout/fragment_order_placement">
        <argument
            android:name="furnitureId"
            app:argType="string" />
        <action
            android:id="@+id/action_orderPlacementFragment_to_myOrdersFragment"
            app:destination="@id/myOrdersFragment"
            app:popUpTo="@id/catalogFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
