<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_assembler"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/poppins_semibold"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_assembler_name"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Full Name"
        app:boxStrokeColor="@color/sage_green"
        app:hintTextColor="@color/sage_green">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_assembler_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_assembler_email"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_email"
        app:boxStrokeColor="@color/sage_green"
        app:hintTextColor="@color/sage_green">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_assembler_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:fontFamily="@font/poppins_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_assembler_phone"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_phone"
        app:boxStrokeColor="@color/sage_green"
        app:hintTextColor="@color/sage_green">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_assembler_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:fontFamily="@font/poppins_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_assembler_area"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_service_area"
        app:boxStrokeColor="@color/sage_green"
        app:hintTextColor="@color/sage_green">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_assembler_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btn_save_assembler"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/add_assembler"
        android:fontFamily="@font/poppins_semibold"
        android:backgroundTint="@color/sage_green"
        android:textColor="@color/white"
        android:elevation="6dp"
        android:stateListAnimator="@null" />

</LinearLayout>
